---
const API_BASE_URL = "https://api.frankiewildlife.bid";
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>添加物种记录</title>
    <style>
        :root {
            --primary-color: #2e7d32;
            --bg-color: #f4f6f8;
            --card-bg: #ffffff;
            --border-color: #dbe5de;
            --text-color: #263b2a;
            --muted-color: #637067;
        }

        body {
            background: var(--bg-color);
            color: var(--text-color);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            margin: 0;
            padding: 28px 18px 44px;
        }

        main {
            margin: 0 auto;
            max-width: 960px;
        }

        .topbar {
            align-items: center;
            display: flex;
            justify-content: space-between;
            margin-bottom: 22px;
            gap: 16px;
        }

        .back-link {
            color: var(--primary-color);
            font-weight: 700;
            text-decoration: none;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        h1 {
            color: #17351d;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(2rem, 5vw, 3rem);
            font-weight: 500;
            line-height: 1.08;
            margin: 0;
        }

        .subtitle {
            color: var(--muted-color);
            margin: 10px 0 0;
        }

        .panel {
            background: var(--card-bg);
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
            padding: 24px;
        }

        .panel + .panel {
            margin-top: 18px;
        }

        .panel-heading {
            align-items: center;
            display: flex;
            gap: 16px;
            justify-content: space-between;
        }

        .form-grid {
            display: grid;
            gap: 18px;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            margin-top: 22px;
        }

        .field {
            display: grid;
            gap: 8px;
        }

        .field.full {
            grid-column: 1 / -1;
        }

        label {
            color: #415146;
            font-size: 0.9rem;
            font-weight: 800;
        }

        input,
        select,
        textarea {
            border: 1px solid var(--border-color);
            border-radius: 8px;
            box-sizing: border-box;
            color: var(--text-color);
            font: inherit;
            padding: 11px 12px;
            width: 100%;
        }

        textarea {
            min-height: 128px;
            resize: vertical;
        }

        input:focus,
        select:focus,
        textarea:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(46, 125, 50, 0.13);
            outline: none;
        }

        .actions {
            align-items: center;
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 22px;
        }

        button {
            background: var(--primary-color);
            border: none;
            border-radius: 8px;
            color: #fff;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 800;
            padding: 12px 18px;
        }

        button:disabled {
            cursor: not-allowed;
            opacity: 0.58;
        }

        .secondary-button {
            background: #edf3ef;
            color: #234b27;
        }

        .danger-button {
            background: #b3261e;
        }

        .text-button {
            background: transparent;
            border: 1px solid var(--border-color);
            color: #2e5134;
        }

        .is-hidden {
            display: none;
        }

        .login-form {
            display: grid;
            gap: 14px;
            margin-top: 22px;
            max-width: 420px;
        }

        .status {
            border-radius: 8px;
            color: #3d4b41;
            display: none;
            font-weight: 700;
            margin-top: 18px;
            padding: 12px 14px;
        }

        .status.show {
            display: block;
        }

        .status.success {
            background: #e7f4ea;
            color: #22632a;
        }

        .status.error {
            background: #fdeaea;
            color: #a92727;
        }

        :global(.preview-list) {
            display: grid;
            gap: 10px;
            margin-top: 8px;
        }

        :global(.preview-item) {
            align-items: center;
            background: #f8faf9;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            display: grid;
            gap: 12px;
            grid-template-columns: 54px minmax(0, 1fr) auto;
            padding: 8px;
        }

        :global(.preview-item img) {
            aspect-ratio: 1;
            border-radius: 6px;
            object-fit: cover;
            width: 54px;
        }

        :global(.preview-name) {
            color: var(--muted-color);
            font-size: 0.9rem;
            overflow-wrap: anywhere;
        }

        :global(.preview-remove) {
            background: #edf3ef;
            border: none;
            border-radius: 7px;
            color: #34513a;
            font-size: 0.86rem;
            padding: 8px 10px;
        }

        .field-note {
            color: var(--muted-color);
            font-size: 0.86rem;
            margin: 0;
        }

        .ai-assist {
            align-items: flex-start;
            background: #f7fbf8;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            display: grid;
            gap: 10px;
            margin-top: 12px;
            padding: 12px;
        }

        .ai-assist-header {
            align-items: center;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: space-between;
        }

        .ai-assist-title {
            color: #234b27;
            font-weight: 900;
        }

        .ai-result-list {
            display: grid;
            gap: 10px;
        }

        .ai-result-card {
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            display: grid;
            gap: 6px;
            padding: 10px;
        }

        .ai-result-name {
            color: #17351d;
            font-weight: 900;
        }

        .ai-result-meta,
        .ai-result-reason {
            color: var(--muted-color);
            font-size: 0.9rem;
            line-height: 1.45;
            margin: 0;
        }

        .ai-result-card button {
            justify-self: start;
            padding: 8px 10px;
        }

        .location-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .location-actions button {
            font-size: 0.92rem;
            padding: 10px 12px;
        }

        .location-map {
            background: #e7ece8;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            height: 320px;
            overflow: hidden;
        }

        .location-map-fallback {
            align-items: center;
            color: var(--muted-color);
            display: flex;
            font-weight: 700;
            height: 100%;
            justify-content: center;
            padding: 18px;
            text-align: center;
        }

        .records-tools {
            margin-top: 18px;
        }

        .records-search {
            position: relative;
        }

        .records-search::before {
            color: #6f7f73;
            content: "⌕";
            font-size: 1.4rem;
            left: 13px;
            line-height: 1;
            position: absolute;
            top: 50%;
            transform: translateY(-52%);
        }

        .records-search input {
            background: #fbfdfb;
            border-radius: 999px;
            padding-left: 42px;
        }

        :global(.records-list) {
            display: grid;
            gap: 12px;
            margin-top: 18px;
        }

        :global(.location-list) {
            display: grid;
            gap: 10px;
            margin-top: 18px;
        }

        :global(.record-item) {
            align-items: center;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            display: grid;
            gap: 14px;
            grid-template-columns: 72px minmax(0, 1fr) auto;
            padding: 12px;
        }

        :global(.location-item) {
            align-items: center;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            display: grid;
            gap: 14px;
            grid-template-columns: minmax(0, 1fr) auto;
            padding: 12px;
        }

        :global(.record-thumb) {
            align-items: center;
            aspect-ratio: 1;
            background: #edf3ef;
            border-radius: 7px;
            color: var(--muted-color);
            display: grid;
            font-size: 0.82rem;
            font-weight: 800;
            justify-content: center;
            object-fit: cover;
            width: 72px;
        }

        :global(.record-title) {
            font-weight: 900;
            margin: 0 0 4px;
        }

        :global(.record-meta) {
            color: var(--muted-color);
            font-size: 0.9rem;
            margin: 0;
            overflow-wrap: anywhere;
        }

        :global(.record-actions) {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            justify-content: flex-end;
        }

        :global(.record-actions button) {
            font-size: 0.92rem;
            padding: 9px 12px;
        }

        .records-heading-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: flex-end;
        }

        :global(.empty-state) {
            border: 1px dashed var(--border-color);
            border-radius: 8px;
            color: var(--muted-color);
            font-weight: 700;
            padding: 18px;
            text-align: center;
        }

        @media (max-width: 720px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .panel {
                padding: 18px;
            }

            .panel-heading,
            :global(.record-item),
            :global(.location-item) {
                align-items: stretch;
                grid-template-columns: 1fr;
            }

            .panel-heading {
                flex-direction: column;
            }

            :global(.record-actions) {
                justify-content: stretch;
            }

            :global(.record-actions button) {
                flex: 1;
            }
        }
    </style>
</head>
<body>
    <main>
        <div class="topbar">
            <a class="back-link" href="/">返回首页</a>
            <button id="logout-button" class="secondary-button is-hidden" type="button">退出登录</button>
        </div>

        <section id="login-panel" class="panel">
            <h1>管理员登录</h1>
            <p class="subtitle">登录后可以添加、编辑和删除物种记录。</p>

            <form id="login-form" class="login-form">
                <div class="field">
                    <label for="login-password">管理密码</label>
                    <input id="login-password" name="password" type="password" autocomplete="current-password" required />
                </div>

                <div class="actions">
                    <button id="login-button" type="submit">登录</button>
                </div>

                <div id="login-status" class="status"></div>
            </form>
        </section>

        <div id="admin-content" class="is-hidden">
        <section class="panel">
            <h1 id="form-title">添加物种记录</h1>
            <p id="form-subtitle" class="subtitle">上传图片后，记录会保存到 Cloudflare R2 和 D1。</p>

            <form id="species-form">
                <div class="form-grid">
                    <div class="field">
                        <label for="name">中文名</label>
                        <input id="name" name="name" type="text" required />
                    </div>

                    <div class="field">
                        <label for="latin-name">Latin name</label>
                        <input id="latin-name" name="latinName" type="text" required />
                    </div>

                    <div class="field">
                        <label for="group-type">类别</label>
                        <select id="group-type" name="groupType" required>
                            <option value="bird">鸟类</option>
                            <option value="mammal">兽类</option>
                            <option value="reptile">爬行类</option>
                            <option value="fish">鱼类</option>
                            <option value="invertebrate">无脊椎类</option>
                        </select>
                    </div>

                    <div class="field">
                        <label for="taxonomy">分类标签</label>
                        <select id="taxonomy" name="taxonomy">
                            <option value="">其他</option>
                            <option value="有鳞目">有鳞目</option>
                            <option value="鲈形目">鲈形目</option>
                            <option value="无尾目">无尾目</option>
                            <option value="雀形目">雀形目</option>
                            <option value="鲤形目">鲤形目</option>
                            <option value="鲇形目">鲇形目</option>
                            <option value="脂鲤目">脂鲤目</option>
                            <option value="啮齿目">啮齿目</option>
                            <option value="翼手目">翼手目</option>
                            <option value="虾虎鱼目">虾虎鱼目</option>
                            <option value="鳉形目">鳉形目</option>
                            <option value="真盲缺目">真盲缺目</option>
                            <option value="有尾目">有尾目</option>
                            <option value="鲉形目">鲉形目</option>
                            <option value="胡瓜鱼目">胡瓜鱼目</option>
                            <option value="偶蹄目">偶蹄目</option>
                            <option value="龟鳖目">龟鳖目</option>
                            <option value="雨燕目">雨燕目</option>
                            <option value="鲱形目">鲱形目</option>
                            <option value="鴷形目">鴷形目</option>
                            <option value="鸻形目">鸻形目</option>
                            <option value="鲹形目">鲹形目</option>
                            <option value="鲆鲽目">鲆鲽目</option>
                            <option value="鲀形目">鲀形目</option>
                            <option value="鹦形目">鹦形目</option>
                            <option value="食肉目">食肉目</option>
                            <option value="鸽形目">鸽形目</option>
                            <option value="鹰形目">鹰形目</option>
                            <option value="鸡形目">鸡形目</option>
                            <option value="真鲨目">真鲨目</option>
                        </select>
                    </div>

                    <div class="field">
                        <label for="iucn">IUCN 等级</label>
                        <select id="iucn" name="iucn">
                            <option value="LC">无危 LC</option>
                            <option value="NT">近危 NT</option>
                            <option value="VU">易危 VU</option>
                            <option value="EN">濒危 EN</option>
                            <option value="CR">极危 CR</option>
                        </select>
                    </div>

                    <div class="field">
                        <label for="location">拍摄地点</label>
                        <input id="location" name="location" type="text" />
                    </div>

                    <div class="field">
                        <label for="location-id">使用已有地点</label>
                        <select id="location-id" name="locationId">
                            <option value="">不绑定地点</option>
                        </select>
                    </div>

                    <div class="field">
                        <label for="shotDate">拍摄日期</label>
                        <input id="shotDate" name="shotDate" type="date" />
                    </div>

                    <div class="field">
                        <label for="latitude">纬度</label>
                        <input id="latitude" name="latitude" type="number" step="any" />
                    </div>

                    <div class="field">
                        <label for="longitude">经度</label>
                        <input id="longitude" name="longitude" type="number" step="any" />
                    </div>

                    <div class="field full">
                        <label for="location-map">地图选择拍摄地点</label>
                        <div id="location-map" class="location-map">
                            <div class="location-map-fallback">登录后加载地图，点击位置会自动填写经纬度。</div>
                        </div>
                        <p class="field-note">也可以继续手动输入经纬度，地图标记会同步移动。</p>
                        <div class="location-actions">
                            <button id="save-location-button" class="secondary-button" type="button">保存当前地点</button>
                        </div>
                    </div>

                    <div class="field full">
                        <label for="note">备注</label>
                        <textarea id="note" name="note"></textarea>
                    </div>

                    <div class="field full">
                        <label for="images">图片</label>
                        <input id="images" name="images" type="file" accept="image/jpeg,image/png,image/webp" multiple />
                        <p id="image-hint" class="field-note">可以一次选择多张，也可以分多次继续添加。</p>
                        <div id="preview-list" class="preview-list"></div>
                        <div class="ai-assist">
                            <div class="ai-assist-header">
                                <div>
                                    <div class="ai-assist-title">AI &#29289;&#31181;&#35782;&#21035;</div>
                                    <p class="field-note">&#20808;&#36873;&#25321;&#22270;&#29255;&#65292;&#28982;&#21518;&#35753; AI &#32473;&#20986;&#20505;&#36873;&#32467;&#26524;&#12290;&#20445;&#23384;&#21069;&#35831;&#20154;&#24037;&#30830;&#35748;&#12290;</p>
                                </div>
                                <button id="identify-button" class="secondary-button" type="button" disabled>AI &#35782;&#21035;&#31532;&#19968;&#24352;&#22270;</button>
                            </div>
                            <div id="identify-results" class="ai-result-list"></div>
                        </div>
                    </div>
                </div>

                <div class="actions">
                    <button id="submit-button" type="submit">保存记录</button>
                    <button id="cancel-edit-button" class="text-button is-hidden" type="button">取消编辑</button>
                    <button class="secondary-button" type="reset">清空</button>
                </div>

                <div id="status" class="status"></div>
            </form>
        </section>

        <section class="panel">
            <div class="panel-heading">
                <div>
                    <h1>地点管理</h1>
                    <p class="subtitle">常用地点保存后，多个物种可以共用同一个地图图钉。</p>
                </div>
            </div>
            <div id="location-list" class="location-list">
                <div class="empty-state">正在读取地点...</div>
            </div>
        </section>

        <section class="panel">
            <div class="panel-heading">
                <div>
                    <h1>已有记录</h1>
                    <p class="subtitle">编辑和删除需要保持管理员登录状态。</p>
                </div>
                <div class="records-heading-actions">
                    <button id="export-button" class="secondary-button" type="button">导出 JSON</button>
                    <button id="refresh-button" class="secondary-button" type="button">刷新</button>
                </div>
            </div>
            <div class="records-tools">
                <label class="records-search" for="records-search">
                    <input id="records-search" type="search" placeholder="搜索中文名或 Latin name" autocomplete="off" />
                </label>
            </div>
            <div id="records-list" class="records-list">
                <div class="empty-state">正在读取记录...</div>
            </div>
        </section>
        </div>
    </main>

    <script is:inline define:vars={{ API_BASE_URL }}>
        var loginPanel = document.getElementById('login-panel');
        var adminContent = document.getElementById('admin-content');
        var loginForm = document.getElementById('login-form');
        var loginPassword = document.getElementById('login-password');
        var loginButton = document.getElementById('login-button');
        var loginStatus = document.getElementById('login-status');
        var logoutButton = document.getElementById('logout-button');
        var form = document.getElementById('species-form');
        var formTitle = document.getElementById('form-title');
        var formSubtitle = document.getElementById('form-subtitle');
        var imagesInput = document.getElementById('images');
        var imageHint = document.getElementById('image-hint');
        var locationInput = document.getElementById('location');
        var locationIdInput = document.getElementById('location-id');
        var saveLocationButton = document.getElementById('save-location-button');
        var latitudeInput = document.getElementById('latitude');
        var longitudeInput = document.getElementById('longitude');
        var locationMapElement = document.getElementById('location-map');
        var previewList = document.getElementById('preview-list');
        var identifyButton = document.getElementById('identify-button');
        var identifyResults = document.getElementById('identify-results');
        var submitButton = document.getElementById('submit-button');
        var cancelEditButton = document.getElementById('cancel-edit-button');
        var statusBox = document.getElementById('status');
        var recordsList = document.getElementById('records-list');
        var recordsSearch = document.getElementById('records-search');
        var locationList = document.getElementById('location-list');
        var exportButton = document.getElementById('export-button');
        var refreshButton = document.getElementById('refresh-button');
        var selectedImages = [];
        var cachedSpecies = [];
        var cachedLocations = [];
        var editingId = null;
        var editingLocationId = null;
        var isApplyingLocation = false;
        var locationMap = null;
        var locationMarker = null;
        var leafletLoader = null;
        var defaultMapCenter = [30.65, 104.06];

        checkAuth();

        loginForm.addEventListener('submit', login);
        logoutButton.addEventListener('click', logout);
        refreshButton.addEventListener('click', loadSpeciesRecords);
        exportButton.addEventListener('click', exportBackup);
        recordsSearch.addEventListener('input', renderRecords);
        identifyButton.addEventListener('click', identifyFirstImage);
        locationIdInput.addEventListener('change', applySelectedLocation);
        saveLocationButton.addEventListener('click', saveCurrentLocation);
        cancelEditButton.addEventListener('click', function() {
            resetEditMode();
        });
        locationInput.addEventListener('input', clearSelectedLocationFromManualEdit);
        latitudeInput.addEventListener('input', clearSelectedLocationFromManualEdit);
        longitudeInput.addEventListener('input', clearSelectedLocationFromManualEdit);
        latitudeInput.addEventListener('change', syncMapFromInputs);
        longitudeInput.addEventListener('change', syncMapFromInputs);

        imagesInput.addEventListener('change', async function() {
            var files = Array.from(imagesInput.files || []);

            if (files.length > 0) {
                showStatus('正在生成展示图和首页缩略图...', '');
            }

            for (var index = 0; index < files.length; index += 1) {
                var file = files[index];
                var compressedFile = await compressImage(file, {
                    maxSide: 1800,
                    quality: 0.82,
                    suffix: ''
                });
                var thumbnailFile = await compressImage(file, {
                    maxSide: 720,
                    quality: 0.76,
                    suffix: '-thumb'
                });
                selectedImages.push({
                    id: Date.now() + '-' + index + '-' + file.name,
                    originalFile: file,
                    compressedFile: compressedFile,
                    thumbnailFile: thumbnailFile,
                    previewUrl: URL.createObjectURL(thumbnailFile)
                });
            }

            if (files.length > 0) {
                renderSelectedImages();
                showStatus('已添加 ' + selectedImages.length + ' 张图片，提交时会上传压缩图和首页缩略图。', 'success');
            }

            imagesInput.value = '';
        });

        form.addEventListener('reset', function() {
            window.setTimeout(function() {
                if (editingId !== null) {
                    resetEditMode();
                } else {
                    clearImageState();
                    showStatus('', '');
                }
            }, 0);
        });

        form.addEventListener('submit', async function(event) {
            event.preventDefault();
            submitButton.disabled = true;
            showStatus('正在上传并保存...', '');

            try {
                var formData = new FormData(form);
                var uploadedImages = [];
                var wasEditing = editingId !== null;
                var uploadMeta = {
                    name: String(formData.get('name') || '').trim(),
                    latinName: String(formData.get('latinName') || '').trim()
                };

                for (var index = 0; index < selectedImages.length; index += 1) {
                    uploadedImages.push(await uploadImageSet(selectedImages[index], uploadMeta));
                }

                var payload = {
                    name: String(formData.get('name') || '').trim(),
                    latinName: String(formData.get('latinName') || '').trim(),
                    groupType: String(formData.get('groupType') || '').trim(),
                    taxonomy: String(formData.get('taxonomy') || '').trim(),
                    iucn: String(formData.get('iucn') || 'LC').trim(),
                    location: String(formData.get('location') || '').trim(),
                    locationId: normalizeLocationId(formData.get('locationId')),
                    shotDate: String(formData.get('shotDate') || '').trim(),
                    latitude: normalizeNumber(formData.get('latitude')),
                    longitude: normalizeNumber(formData.get('longitude')),
                    note: String(formData.get('note') || '').trim(),
                };

                if (!wasEditing || uploadedImages.length > 0) {
                    payload.images = uploadedImages;
                }

                var response = await fetch(API_BASE_URL + (wasEditing ? '/species/' + editingId : '/species'), {
                    method: wasEditing ? 'PUT' : 'POST',
                    credentials: 'include',
                    headers: {
                        'content-type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    throw new Error(await readError(response));
                }

                form.reset();
                resetEditMode();
                await loadSpeciesRecords();
                showStatus(wasEditing ? '修改成功，首页会读取最新数据。' : '保存成功，记录已经进入 D1。', 'success');
            } catch (error) {
                showStatus(error.message || '保存失败，请检查登录状态和网络。', 'error');
            } finally {
                submitButton.disabled = false;
            }
        });

        async function checkAuth() {
            try {
                var response = await fetch(API_BASE_URL + '/auth/me', {
                    credentials: 'include'
                });
                var data = response.ok ? await response.json() : { authenticated: false };
                if (data.authenticated) {
                    showAdmin();
                } else {
                    showLogin();
                }
            } catch (error) {
                showLogin();
            }
        }

        async function login(event) {
            event.preventDefault();
            loginButton.disabled = true;
            showLoginStatus('正在登录...', '');

            try {
                var formData = new FormData(loginForm);
                var password = String(formData.get('password') || '').trim();
                var response = await fetch(API_BASE_URL + '/auth/login', {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'content-type': 'application/json' },
                    body: JSON.stringify({ password: password })
                });

                if (!response.ok) {
                    throw new Error(await readError(response));
                }

                loginPassword.value = '';
                showLoginStatus('', '');
                showAdmin();
            } catch (error) {
                showLoginStatus(error.message || '登录失败，请检查管理密码。', 'error');
            } finally {
                loginButton.disabled = false;
            }
        }

        async function logout() {
            logoutButton.disabled = true;
            try {
                await fetch(API_BASE_URL + '/auth/logout', {
                    method: 'POST',
                    credentials: 'include'
                });
            } finally {
                resetEditMode();
                cachedSpecies = [];
                recordsList.innerHTML = '<div class="empty-state">正在读取记录...</div>';
                showLogin();
                logoutButton.disabled = false;
            }
        }

        function showAdmin() {
            loginPanel.classList.add('is-hidden');
            adminContent.classList.remove('is-hidden');
            logoutButton.classList.remove('is-hidden');
            loadLocations();
            loadSpeciesRecords();
            initLocationMap();
        }

        function showLogin() {
            loginPanel.classList.remove('is-hidden');
            adminContent.classList.add('is-hidden');
            logoutButton.classList.add('is-hidden');
        }

        async function loadSpeciesRecords() {
            recordsList.innerHTML = '<div class="empty-state">正在读取记录...</div>';
            refreshButton.disabled = true;

            try {
                var response = await fetch(API_BASE_URL + '/species');
                if (!response.ok) {
                    throw new Error(await readError(response));
                }

                var data = await response.json();
                cachedSpecies = Array.isArray(data.species) ? data.species : [];
                renderRecords();
            } catch (error) {
                recordsList.innerHTML = '';
                recordsList.appendChild(createEmptyState(error.message || '记录读取失败。'));
            } finally {
                refreshButton.disabled = false;
            }
        }

        async function loadLocations() {
            try {
                var response = await fetch(API_BASE_URL + '/locations');
                if (!response.ok) {
                    throw new Error(await readError(response));
                }

                var data = await response.json();
                cachedLocations = Array.isArray(data.locations) ? data.locations : [];
                renderLocationOptions();
                renderLocations();
            } catch (error) {
                cachedLocations = [];
                renderLocationOptions();
                renderLocations();
                showStatus(error.message || '地点读取失败，可以继续手动填写地点。', 'error');
            }
        }

        function renderLocationOptions() {
            var currentValue = locationIdInput.value;
            locationIdInput.innerHTML = '<option value="">不绑定地点</option>';

            cachedLocations.forEach(function(location) {
                var option = document.createElement('option');
                option.value = String(location.id);
                option.textContent = location.name + (location.coordinates ? ' · ' + location.coordinates.join(', ') : '');
                locationIdInput.appendChild(option);
            });

            locationIdInput.value = cachedLocations.some(function(location) {
                return String(location.id) === currentValue;
            }) ? currentValue : '';
        }

        function ensureLocationOption(locationId, label) {
            if (!locationId) {
                return;
            }

            var value = String(locationId);
            if (locationIdInput.querySelector('option[value="' + value.replace(/"/g, '\\"') + '"]')) {
                return;
            }

            var option = document.createElement('option');
            option.value = value;
            option.textContent = label ? label + ' · 已绑定地点' : '已绑定地点 #' + value;
            locationIdInput.appendChild(option);
        }

        function renderLocations() {
            locationList.innerHTML = '';

            if (cachedLocations.length === 0) {
                locationList.appendChild(createEmptyState('还没有保存地点。先填写地点和经纬度，再点击“保存当前地点”。'));
                return;
            }

            cachedLocations.forEach(function(location) {
                var item = document.createElement('article');
                item.className = 'location-item';

                var content = document.createElement('div');
                var title = document.createElement('p');
                title.className = 'record-title';
                title.textContent = location.name || '未命名地点';

                var meta = document.createElement('p');
                meta.className = 'record-meta';
                meta.textContent = location.coordinates ? location.coordinates.join(', ') : '未设置经纬度';

                content.appendChild(title);
                content.appendChild(meta);

                var actions = document.createElement('div');
                actions.className = 'record-actions';

                var useButton = document.createElement('button');
                useButton.className = 'secondary-button';
                useButton.type = 'button';
                useButton.textContent = '使用';
                useButton.addEventListener('click', function() {
                    useLocation(location);
                });

                var editButton = document.createElement('button');
                editButton.className = 'text-button';
                editButton.type = 'button';
                editButton.textContent = '编辑';
                editButton.addEventListener('click', function() {
                    editLocation(location);
                });

                var deleteButton = document.createElement('button');
                deleteButton.className = 'danger-button';
                deleteButton.type = 'button';
                deleteButton.textContent = '删除';
                deleteButton.addEventListener('click', function() {
                    deleteLocation(location);
                });

                actions.appendChild(useButton);
                actions.appendChild(editButton);
                actions.appendChild(deleteButton);
                item.appendChild(content);
                item.appendChild(actions);
                locationList.appendChild(item);
            });
        }

        function useLocation(location) {
            locationIdInput.value = String(location.id);
            applySelectedLocation();
        }

        function editLocation(location) {
            editingLocationId = location.id;
            isApplyingLocation = true;
            locationInput.value = location.name || '';
            locationIdInput.value = String(location.id);
            if (location.coordinates) {
                setMapLocation(location.coordinates[0], location.coordinates[1], true);
            }
            isApplyingLocation = false;
            saveLocationButton.textContent = '保存地点修改';
            showStatus('正在编辑地点：' + (location.name || '未命名地点'), '');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function applySelectedLocation() {
            var selectedId = normalizeLocationId(locationIdInput.value);
            if (selectedId === null) {
                return;
            }

            var selectedLocation = cachedLocations.find(function(location) {
                return Number(location.id) === selectedId;
            });
            if (!selectedLocation) {
                return;
            }

            isApplyingLocation = true;
            locationInput.value = selectedLocation.name || '';
            if (selectedLocation.coordinates) {
                setMapLocation(selectedLocation.coordinates[0], selectedLocation.coordinates[1], true);
            }
            isApplyingLocation = false;
            showStatus('已使用地点：' + selectedLocation.name, 'success');
        }

        async function saveCurrentLocation() {
            var name = locationInput.value.trim();
            var latitude = normalizeNumber(latitudeInput.value);
            var longitude = normalizeNumber(longitudeInput.value);

            if (!name) {
                showStatus('请先填写拍摄地点名称。', 'error');
                return;
            }

            if (latitude === null || longitude === null) {
                showStatus('请先填写经纬度，或在地图上点击地点。', 'error');
                return;
            }

            saveLocationButton.disabled = true;
            showStatus('正在保存地点...', '');

            try {
                var response = await fetch(API_BASE_URL + (editingLocationId ? '/locations/' + editingLocationId : '/locations'), {
                    method: editingLocationId ? 'PUT' : 'POST',
                    credentials: 'include',
                    headers: { 'content-type': 'application/json' },
                    body: JSON.stringify({
                        name: name,
                        latitude: latitude,
                        longitude: longitude,
                        note: ''
                    })
                });

                if (!response.ok) {
                    throw new Error(await readError(response));
                }

                var data = await response.json();
                var savedLocationId = editingLocationId || (data.location && data.location.id);
                editingLocationId = null;
                saveLocationButton.textContent = '保存当前地点';
                await loadLocations();
                if (savedLocationId) {
                    locationIdInput.value = String(savedLocationId);
                }
                showStatus('地点已保存，以后可以直接选择。', 'success');
            } catch (error) {
                showStatus(error.message || '地点保存失败，请检查登录状态。', 'error');
            } finally {
                saveLocationButton.disabled = false;
            }
        }

        async function deleteLocation(location) {
            if (!window.confirm('确认删除地点“' + (location.name || '这个地点') + '”？物种记录会保留，但会解除地点绑定。')) {
                return;
            }

            showStatus('正在删除地点...', '');

            try {
                var response = await fetch(API_BASE_URL + '/locations/' + location.id, {
                    method: 'DELETE',
                    credentials: 'include'
                });

                if (!response.ok) {
                    throw new Error(await readError(response));
                }

                if (String(locationIdInput.value) === String(location.id)) {
                    locationIdInput.value = '';
                }
                if (editingLocationId === location.id) {
                    editingLocationId = null;
                    saveLocationButton.textContent = '保存当前地点';
                }

                await loadLocations();
                await loadSpeciesRecords();
                showStatus('地点已删除，相关物种记录仍然保留。', 'success');
            } catch (error) {
                showStatus(error.message || '地点删除失败，请检查登录状态。', 'error');
            }
        }

        function clearSelectedLocationFromManualEdit() {
            if (isApplyingLocation) {
                return;
            }
            locationIdInput.value = '';
        }

        async function exportBackup() {
            exportButton.disabled = true;
            showStatus('正在生成备份文件...', '');

            try {
                var response = await fetch(API_BASE_URL + '/backup', {
                    credentials: 'include'
                });
                if (!response.ok) {
                    throw new Error(await readError(response));
                }

                var blob = await response.blob();
                var filename = getDownloadFilename(response.headers.get('content-disposition')) || buildBackupFilename();
                var url = URL.createObjectURL(blob);
                var link = document.createElement('a');
                link.href = url;
                link.download = filename;
                document.body.appendChild(link);
                link.click();
                link.remove();
                URL.revokeObjectURL(url);
                showStatus('备份文件已导出。', 'success');
            } catch (error) {
                showStatus(error.message || '备份导出失败，请检查登录状态和网络。', 'error');
            } finally {
                exportButton.disabled = false;
            }
        }

        function renderRecords() {
            recordsList.innerHTML = '';

            if (cachedSpecies.length === 0) {
                recordsList.appendChild(createEmptyState('还没有通过后台新增的记录。'));
                return;
            }

            var keyword = recordsSearch.value.trim().toLowerCase();
            var visibleSpecies = cachedSpecies.filter(function(record) {
                if (!keyword) {
                    return true;
                }

                return [record.name, record.latinName].some(function(value) {
                    return String(value || '').toLowerCase().includes(keyword);
                });
            });

            if (visibleSpecies.length === 0) {
                recordsList.appendChild(createEmptyState('没有找到匹配的记录。'));
                return;
            }

            visibleSpecies.forEach(function(record) {
                var item = document.createElement('article');
                item.className = 'record-item';

                var thumb;
                if (record.images && record.images[0]) {
                    thumb = document.createElement('img');
                    thumb.alt = record.name || '物种图片';
                    thumb.src = record.images[0].thumbnailUrl || record.images[0].thumbnail_url || record.images[0].url;
                } else {
                    thumb = document.createElement('div');
                    thumb.textContent = '无图';
                }
                thumb.className = 'record-thumb';

                var content = document.createElement('div');
                var title = document.createElement('p');
                title.className = 'record-title';
                title.textContent = record.name || '未命名物种';

                var meta = document.createElement('p');
                meta.className = 'record-meta';
                meta.textContent = [record.latinName, record.location, record.shotDate, record.iucn, formatEditedDate(record.updatedAt)].filter(Boolean).join(' · ');

                content.appendChild(title);
                content.appendChild(meta);

                var actions = document.createElement('div');
                actions.className = 'record-actions';

                var editButton = document.createElement('button');
                editButton.className = 'text-button';
                editButton.type = 'button';
                editButton.textContent = '编辑';
                editButton.addEventListener('click', function() {
                    startEdit(record);
                });

                var deleteButton = document.createElement('button');
                deleteButton.className = 'danger-button';
                deleteButton.type = 'button';
                deleteButton.textContent = '删除';
                deleteButton.addEventListener('click', function() {
                    deleteRecord(record);
                });

                actions.appendChild(editButton);
                actions.appendChild(deleteButton);

                item.appendChild(thumb);
                item.appendChild(content);
                item.appendChild(actions);
                recordsList.appendChild(item);
            });
        }

        function startEdit(record) {
            editingId = record.id;
            formTitle.textContent = '编辑物种记录';
            formSubtitle.textContent = '保存修改需要管理密码；不重新选择图片时会保留原图。';
            submitButton.textContent = '保存修改';
            cancelEditButton.classList.remove('is-hidden');
            imageHint.textContent = '可以一次选择多张，也可以分多次继续添加；留空则继续使用原图。';

            form.elements.name.value = record.name || '';
            form.elements.latinName.value = record.latinName || '';
            form.elements.groupType.value = record.groupType || 'bird';
            form.elements.taxonomy.value = normalizeTaxonomyValue(record.taxonomy);
            form.elements.iucn.value = record.iucn || 'LC';
            form.elements.location.value = record.location || '';
            ensureLocationOption(record.locationId, record.location);
            form.elements.locationId.value = record.locationId ? String(record.locationId) : '';
            form.elements.shotDate.value = record.shotDate || '';
            form.elements.latitude.value = record.coordinates ? record.coordinates[0] : '';
            form.elements.longitude.value = record.coordinates ? record.coordinates[1] : '';
            form.elements.note.value = record.note || '';
            clearImageState();
            if (record.coordinates) {
                setMapLocation(record.coordinates[0], record.coordinates[1], true);
            } else {
                clearMapLocation();
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
            showStatus('正在编辑：' + (record.name || '未命名物种'), '');
        }

        function normalizeTaxonomyValue(value) {
            if (value === 'passerine') return '雀形目';
            if (value === 'carnivora') return '食肉目';
            if (value === 'artiodactyla') return '偶蹄目';
            return value || '';
        }

        function formatEditedDate(value) {
            if (!value) {
                return '';
            }

            return '编辑于 ' + String(value).slice(0, 10);
        }

        function getDownloadFilename(contentDisposition) {
            if (!contentDisposition) {
                return '';
            }

            var match = contentDisposition.match(/filename="([^"]+)"/);
            return match ? match[1] : '';
        }

        function buildBackupFilename() {
            return 'wildlife-backup-' + new Date().toISOString().slice(0, 10) + '.json';
        }

        async function deleteRecord(record) {
            if (!window.confirm('确认删除“' + (record.name || '这条记录') + '”？对应的 R2 图片也会删除。')) {
                return;
            }

            refreshButton.disabled = true;
            showStatus('正在删除...', '');

            try {
                var response = await fetch(API_BASE_URL + '/species/' + record.id, {
                    method: 'DELETE',
                    credentials: 'include'
                });

                if (!response.ok) {
                    throw new Error(await readError(response));
                }

                if (editingId === record.id) {
                    resetEditMode();
                }

                await loadSpeciesRecords();
                showStatus('删除成功。', 'success');
            } catch (error) {
                showStatus(error.message || '删除失败，请检查登录状态。', 'error');
            } finally {
                refreshButton.disabled = false;
            }
        }

        async function uploadImageSet(selectedImage, meta) {
            var image = await uploadImage(selectedImage.compressedFile, meta, 'large');
            var thumbnail = await uploadImage(selectedImage.thumbnailFile, meta, 'thumb');

            return {
                url: image.url,
                key: image.key,
                thumbnailUrl: thumbnail.url,
                thumbnailKey: thumbnail.key
            };
        }

        async function uploadImage(file, meta, variant) {
            var body = new FormData();
            body.append('image', file);
            body.append('latinName', meta.latinName || '');
            body.append('name', meta.name || '');
            body.append('variant', variant || 'large');

            var response = await fetch(API_BASE_URL + '/upload', {
                method: 'POST',
                credentials: 'include',
                body: body
            });

            if (!response.ok) {
                throw new Error(await readError(response));
            }

            return response.json();
        }

        async function compressImage(file, options) {
            if (!file.type.startsWith('image/')) {
                return file;
            }

            var settings = options || {};
            var image = await loadImage(file);
            var maxSide = settings.maxSide || 1800;
            var scale = Math.min(1, maxSide / Math.max(image.naturalWidth, image.naturalHeight));
            var width = Math.max(1, Math.round(image.naturalWidth * scale));
            var height = Math.max(1, Math.round(image.naturalHeight * scale));
            var canvas = document.createElement('canvas');
            var context = canvas.getContext('2d');

            canvas.width = width;
            canvas.height = height;
            if (!context) {
                throw new Error('当前浏览器不支持图片压缩，请换一个浏览器再试。');
            }
            context.drawImage(image, 0, 0, width, height);
            URL.revokeObjectURL(image.src);

            var blob = await canvasToBlob(canvas, 'image/webp', settings.quality || 0.82);
            var basename = file.name.replace(/\.[^.]+$/, '') || 'wildlife-photo';
            return new File([blob], basename + (settings.suffix || '') + '.webp', {
                type: 'image/webp',
                lastModified: Date.now()
            });
        }

        function loadImage(file) {
            return new Promise(function(resolve, reject) {
                var image = new Image();
                image.onload = function() { resolve(image); };
                image.onerror = function() { reject(new Error('图片读取失败，请换一张 JPEG、PNG 或 WebP。')); };
                image.src = URL.createObjectURL(file);
            });
        }

        function canvasToBlob(canvas, type, quality) {
            return new Promise(function(resolve, reject) {
                canvas.toBlob(function(blob) {
                    if (blob) {
                        resolve(blob);
                    } else {
                        reject(new Error('图片压缩失败，请换一张图片。'));
                    }
                }, type, quality);
            });
        }

        function formatFileSize(bytes) {
            if (bytes < 1024 * 1024) {
                return Math.round(bytes / 1024) + ' KB';
            }
            return (bytes / 1024 / 1024).toFixed(1) + ' MB';
        }

        function normalizeNumber(value) {
            var text = String(value || '').trim();
            return text ? Number(text) : null;
        }

        function normalizeLocationId(value) {
            var text = String(value || '').trim();
            if (!text) {
                return null;
            }
            var number = Number(text);
            return Number.isSafeInteger(number) && number > 0 ? number : null;
        }

        function resetEditMode() {
            editingId = null;
            form.reset();
            formTitle.textContent = '添加物种记录';
            formSubtitle.textContent = '上传图片后，记录会保存到 Cloudflare R2 和 D1。';
            submitButton.textContent = '保存记录';
            cancelEditButton.classList.add('is-hidden');
            imageHint.textContent = '可以一次选择多张，也可以分多次继续添加。';
            clearImageState();
            clearMapLocation();
            locationIdInput.value = '';
            editingLocationId = null;
            saveLocationButton.textContent = '保存当前地点';
        }

        async function initLocationMap() {
            try {
                await loadLeaflet();
                if (locationMap || typeof L === 'undefined') {
                    if (locationMap) {
                        window.setTimeout(function() {
                            locationMap.invalidateSize();
                        }, 0);
                    }
                    return;
                }

                locationMapElement.innerHTML = '';
                locationMap = L.map('location-map').setView(defaultMapCenter, 5);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap'
                }).addTo(locationMap);

                locationMap.on('click', function(event) {
                    setMapLocation(event.latlng.lat, event.latlng.lng, false);
                });

                syncMapFromInputs();
                window.setTimeout(function() {
                    locationMap.invalidateSize();
                }, 0);
            } catch (error) {
                locationMapElement.innerHTML = '<div class="location-map-fallback">地图加载失败，请先手动输入经纬度。</div>';
            }
        }

        function loadLeaflet() {
            if (window.L) {
                return Promise.resolve();
            }

            if (leafletLoader) {
                return leafletLoader;
            }

            leafletLoader = new Promise(function(resolve, reject) {
                var stylesheet = document.createElement('link');
                stylesheet.rel = 'stylesheet';
                stylesheet.href = 'https://cdn.staticfile.net/leaflet/1.9.4/leaflet.css';
                document.head.appendChild(stylesheet);

                var script = document.createElement('script');
                script.src = 'https://cdn.staticfile.net/leaflet/1.9.4/leaflet.js';
                script.onload = function() { resolve(); };
                script.onerror = function() { reject(new Error('Leaflet failed to load')); };
                document.head.appendChild(script);
            });

            return leafletLoader;
        }

        function syncMapFromInputs() {
            var latitude = normalizeNumber(latitudeInput.value);
            var longitude = normalizeNumber(longitudeInput.value);

            if (latitude === null || longitude === null) {
                return;
            }

            setMapLocation(latitude, longitude, true);
        }

        function setMapLocation(latitude, longitude, keepZoom) {
            if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) {
                return;
            }

            latitudeInput.value = latitude.toFixed(6);
            longitudeInput.value = longitude.toFixed(6);

            if (!locationMap || typeof L === 'undefined') {
                return;
            }

            var latLng = [latitude, longitude];
            if (!locationMarker) {
                locationMarker = L.marker(latLng).addTo(locationMap);
            } else {
                locationMarker.setLatLng(latLng);
            }

            if (keepZoom) {
                locationMap.setView(latLng, Math.max(locationMap.getZoom(), 10));
            } else {
                locationMap.panTo(latLng);
            }
        }

        function clearMapLocation() {
            if (locationMarker && locationMap) {
                locationMap.removeLayer(locationMarker);
                locationMarker = null;
            }
        }

        function renderSelectedImages() {
            previewList.innerHTML = '';

            selectedImages.forEach(function(selectedImage) {
                var item = document.createElement('div');
                item.className = 'preview-item';

                var img = document.createElement('img');
                img.src = selectedImage.previewUrl;
                img.alt = selectedImage.compressedFile.name;

                var name = document.createElement('div');
                name.className = 'preview-name';
                name.textContent = selectedImage.compressedFile.name + ' · ' + formatFileSize(selectedImage.originalFile.size) + ' → ' + formatFileSize(selectedImage.compressedFile.size);

                var removeButton = document.createElement('button');
                removeButton.className = 'preview-remove';
                removeButton.type = 'button';
                removeButton.textContent = '移除';
                removeButton.addEventListener('click', function() {
                    removeSelectedImage(selectedImage.id);
                });

                item.appendChild(img);
                item.appendChild(name);
                item.appendChild(removeButton);
                previewList.appendChild(item);
            });
            updateIdentifyState();
        }

        function removeSelectedImage(id) {
            var nextImages = [];
            selectedImages.forEach(function(selectedImage) {
                if (selectedImage.id === id) {
                    URL.revokeObjectURL(selectedImage.previewUrl);
                } else {
                    nextImages.push(selectedImage);
                }
            });
            selectedImages = nextImages;
            renderSelectedImages();
            clearIdentifyResults();
            showStatus(selectedImages.length > 0 ? '已添加 ' + selectedImages.length + ' 张图片。' : '', '');
        }

        function clearImageState() {
            imagesInput.value = '';
            previewList.innerHTML = '';
            selectedImages.forEach(function(selectedImage) {
                URL.revokeObjectURL(selectedImage.previewUrl);
            });
            selectedImages = [];
            clearIdentifyResults();
            updateIdentifyState();
        }

        function updateIdentifyState() {
            identifyButton.disabled = selectedImages.length === 0;
        }

        function clearIdentifyResults() {
            identifyResults.innerHTML = '';
        }

        async function identifyFirstImage() {
            if (selectedImages.length === 0) {
                showStatus('请先选择至少一张图片。', 'error');
                return;
            }

            identifyButton.disabled = true;
            identifyButton.textContent = 'AI 识别中...';
            identifyResults.innerHTML = '';
            showStatus('正在识别第一张图片，请稍等。', '');

            try {
                var body = new FormData();
                body.append('image', selectedImages[0].compressedFile);
                appendIdentifyContext(body, 'location', form.elements.location.value);
                appendIdentifyContext(body, 'latitude', form.elements.latitude.value);
                appendIdentifyContext(body, 'longitude', form.elements.longitude.value);
                appendIdentifyContext(body, 'shotDate', form.elements.shotDate.value);
                appendIdentifyContext(body, 'groupType', form.elements.groupType.value);
                appendIdentifyContext(body, 'taxonomy', form.elements.taxonomy.value);
                appendIdentifyContext(body, 'note', form.elements.note.value);

                var response = await fetch(API_BASE_URL + '/identify', {
                    method: 'POST',
                    credentials: 'include',
                    body: body
                });

                if (!response.ok) {
                    throw new Error(await readError(response));
                }

                var data = await response.json();
                renderIdentifyResults(Array.isArray(data.candidates) ? data.candidates : [], data.rawText || '', {
                    provider: data.provider || '',
                    model: data.model || ''
                });
            } catch (error) {
                identifyResults.innerHTML = '';
                showStatus(error.message || 'AI 识别失败，请稍后再试。', 'error');
            } finally {
                identifyButton.textContent = 'AI 识别第一张图';
                updateIdentifyState();
            }
        }

        function appendIdentifyContext(body, key, value) {
            var text = String(value || '').trim();
            if (text) {
                body.append(key, text);
            }
        }

        function renderIdentifyResults(candidates, rawText, source) {
            identifyResults.innerHTML = '';
            renderIdentifySource(source);

            if (!candidates.length) {
                identifyResults.appendChild(createEmptyState('AI 暂时没有给出可靠候选结果。'));
                if (rawText) {
                    var rawCard = document.createElement('div');
                    rawCard.className = 'ai-result-card';

                    var rawTitle = document.createElement('div');
                    rawTitle.className = 'ai-result-name';
                    rawTitle.textContent = 'AI 原始回答';

                    var rawBody = document.createElement('p');
                    rawBody.className = 'ai-result-reason';
                    rawBody.textContent = rawText.slice(0, 1200);

                    rawCard.appendChild(rawTitle);
                    rawCard.appendChild(rawBody);
                    identifyResults.appendChild(rawCard);
                }
                showStatus('AI 没有识别出可靠结果，你可以手动填写。', '');
                return;
            }

            candidates.forEach(function(candidate, index) {
                var card = document.createElement('div');
                card.className = 'ai-result-card';

                var name = document.createElement('div');
                name.className = 'ai-result-name';
                name.textContent = (candidate.name || '未给出中文名') + (candidate.latinName ? ' / ' + candidate.latinName : '');

                var meta = document.createElement('p');
                meta.className = 'ai-result-meta';
                meta.textContent = [
                    candidate.groupType ? '类群：' + labelGroupType(candidate.groupType) : '',
                    candidate.taxonomy ? '分类：' + candidate.taxonomy : '',
                    candidate.confidence ? '置信度：' + candidate.confidence : ''
                ].filter(Boolean).join(' · ');

                var reason = document.createElement('p');
                reason.className = 'ai-result-reason';
                reason.textContent = candidate.reason || '请结合原图人工确认。';

                var useButton = document.createElement('button');
                useButton.className = 'secondary-button';
                useButton.type = 'button';
                useButton.textContent = index === 0 ? '使用推荐结果' : '使用此结果';
                useButton.addEventListener('click', function() {
                    applyIdentifyCandidate(candidate);
                });

                card.appendChild(name);
                card.appendChild(meta);
                card.appendChild(reason);
                card.appendChild(useButton);
                identifyResults.appendChild(card);
            });

            showStatus('AI 已给出候选结果，请确认后再保存。', 'success');
        }

        function renderIdentifySource(source) {
            if (!source || (!source.provider && !source.model)) {
                return;
            }

            var sourceLine = document.createElement('p');
            sourceLine.className = 'ai-result-meta';
            sourceLine.textContent = 'AI 来源：' + [source.provider, source.model].filter(Boolean).join(' / ');
            identifyResults.appendChild(sourceLine);
        }

        function applyIdentifyCandidate(candidate) {
            if (candidate.name) form.elements.name.value = candidate.name;
            if (candidate.latinName) form.elements.latinName.value = candidate.latinName;
            if (candidate.groupType && candidate.groupType !== 'other') form.elements.groupType.value = candidate.groupType;
            if (candidate.taxonomy && hasSelectOption(form.elements.taxonomy, candidate.taxonomy)) {
                form.elements.taxonomy.value = candidate.taxonomy;
            }
            if (candidate.reason && !form.elements.note.value.trim()) {
                form.elements.note.value = 'AI 识别参考：' + candidate.reason;
            }
            showStatus('已填入 AI 候选结果，请人工确认后保存。', 'success');
        }

        function hasSelectOption(select, value) {
            return Array.from(select.options).some(function(option) {
                return option.value === value;
            });
        }

        function labelGroupType(value) {
            if (value === 'bird') return '鸟类';
            if (value === 'mammal') return '兽类';
            if (value === 'reptile') return '爬行类';
            if (value === 'fish') return '鱼类';
            if (value === 'invertebrate') return '无脊椎类';
            return '其他';
        }

        function createEmptyState(message) {
            var state = document.createElement('div');
            state.className = 'empty-state';
            state.textContent = message;
            return state;
        }

        async function readError(response) {
            try {
                var data = await response.json();
                return data.error || '请求失败';
            } catch (error) {
                return '请求失败';
            }
        }

        function showStatus(message, type) {
            statusBox.textContent = message;
            statusBox.className = 'status' + (message ? ' show' : '') + (type ? ' ' + type : '');
        }

        function showLoginStatus(message, type) {
            loginStatus.textContent = message;
            loginStatus.className = 'status' + (message ? ' show' : '') + (type ? ' ' + type : '');
        }
    </script>
</body>
</html>
