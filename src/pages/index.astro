    <script src="https://unpkg.com/maplibre-gl@5.9.0/dist/maplibre-gl.js" is:inline></script>
    <script id="animals-data" type="application/json" is:inline set:html={JSON.stringify(animals)}></script>

    <script is:inline define:vars={{ API_BASE_URL, MAPTILER_API_KEY }}>
        var rawData = document.getElementById('animals-data').textContent;
        var animals = JSON.parse(rawData);

        var currentAnimalIndex = 0;
        var currentImageIndex = 0;
        var wildlifeMap = null;
        var mapPopup = null;
        var mapMarkerFeatures = [];
        var mapMarkerOverlay = null;
        var mapMarkerStatus = null;
        var hasLoadedRemoteSpecies = false;
        var MARKER_CLUSTER_RADIUS_METERS = 150;
        var currentFilter = { iucn: 'all', group: 'all', search: '' };
        var sidebarGroups = {
            all: 'all',
            bird: 'bird',
            mammal: 'mammal',
            reptile: 'reptile',
            fish: 'fish',
            invertebrate: 'invertebrate'
        };

        function updateHeroStats() {
            var speciesCount = document.getElementById('species-count');
            var locationCount = document.getElementById('location-count');
            var photoCount = document.getElementById('photo-count');
            var archivePeriod = document.getElementById('archive-period');
            var collectionSummary = document.getElementById('collection-summary');
            var mapSummary = document.getElementById('map-summary');
            var locations = new Set();
            var photos = 0;
            var years = [];
            var groupCounts = {
                all: animals.length,
                bird: 0,
                mammal: 0,
                reptile: 0,
                fish: 0,
                invertebrate: 0
            };

            animals.forEach(function(item) {
                if (item.locationId) {
                    locations.add('id:' + item.locationId);
                } else if (item.location) {
                    locations.add('name:' + item.location);
                }
                photos += item.images ? item.images.length : 0;
                if (groupCounts[item.groupType] !== undefined) {
                    groupCounts[item.groupType] += 1;
                }
                if (item.shotDate) {
                    var year = String(item.shotDate).slice(0, 4);
                    if (/^\d{4}$/.test(year)) {
                        years.push(Number(year));
                    }
                }
            });

            speciesCount.textContent = String(animals.length);
            locationCount.textContent = String(locations.size);
            photoCount.textContent = String(photos);
            if (archivePeriod) archivePeriod.textContent = formatArchivePeriod(years);
            if (collectionSummary) collectionSummary.textContent = animals.length + ' Records';
            if (mapSummary) {
                mapSummary.textContent = animals.length + ' records · ' + locations.size + ' locations · ' + photos + ' photos';
            }

            updateCountText('tab-all-count', groupCounts.all);
            updateCountText('tab-bird-count', groupCounts.bird);
            updateCountText('tab-mammal-count', groupCounts.mammal);
            updateCountText('tab-reptile-count', groupCounts.reptile);
            updateCountText('tab-fish-count', groupCounts.fish);
            updateCountText('tab-invertebrate-count', groupCounts.invertebrate);
        }

        function updateCountText(id, value) {
            var element = document.getElementById(id);
            if (element) {
                element.textContent = String(value);
            }
        }

        function formatArchivePeriod(years) {
            if (!years.length) {
                return '2024-2026';
            }

            var minYear = Math.min.apply(null, years);
            var maxYear = Math.max.apply(null, years);
            return minYear === maxYear ? String(minYear) : minYear + '-' + maxYear;
        }

        function normalizeApiAnimal(item) {
            var normalizedImages = Array.isArray(item.images)
                ? item.images.map(function(image) {
                    if (typeof image === 'string') {
                        return { url: image, thumbnailUrl: image };
                    }

                    return {
                        url: image && image.url,
                        thumbnailUrl: image && (image.thumbnailUrl || image.thumbnail_url || image.thumbUrl || image.thumb_url || image.url)
                    };
                }).filter(function(image) {
                    return image.url;
                })
                : [];

            return {
                name: item.name || '',
                latinName: item.latinName || item.latin_name || '',
                location: item.location || '',
                locationId: item.locationId || item.location_id || null,
                shotDate: item.shotDate || item.shot_date || '',
                iucn: item.iucn || 'LC',
                groupType: item.groupType || item.group_type || inferGroupType(item.taxonomy) || 'other',
                taxonomy: normalizeTaxonomy(item.taxonomy),
                coords: Array.isArray(item.coordinates) ? item.coordinates : null,
                exif: item.exif || '',
                images: normalizedImages.map(function(image) { return image.url; }),
                thumbnails: normalizedImages.map(function(image) { return image.thumbnailUrl || image.url; }),
                desc: item.desc || item.note || ''
            };
        }

        function iucnLabel(value) {
            if (value === 'CR') return '\u6781\u5371 CR';
            if (value === 'EN') return '\u6fd2\u5371 EN';
            if (value === 'VU') return '\u6613\u5371 VU';
            if (value === 'NT') return '\u8fd1\u5371 NT';
            return '\u65e0\u5371 LC';
        }

        function taxonomyLabel(value) {
            if (value === 'passerine') return '\u96c0\u5f62\u76ee';
            if (value === 'waterbird') return '\u6e38\u79bd / \u6c34\u9e1f';
            if (value === 'raptor') return '\u731b\u79bd';
            if (value === 'carnivora') return '\u98df\u8089\u76ee';
            if (value === 'artiodactyla') return '\u5076\u8e44\u76ee';
            if (value === 'bird') return '\u9e1f\u7c7b';
            if (value === 'mammal') return '\u517d\u7c7b';
            if (value === 'reptile') return '爬行类';
            if (value === 'fish') return '\u9c7c\u7c7b';
            if (value === 'invertebrate') return '\u65e0\u810a\u690e\u7c7b';
            return value || '\u672a\u5206\u7c7b';
        }
        function normalizeTaxonomy(value) {
            return taxonomyLabel(value);
        }

        function inferGroupType(taxonomy) {
            if (taxonomy === 'passerine' || taxonomy === 'waterbird' || taxonomy === 'raptor') return 'bird';
            if (taxonomy === 'carnivora' || taxonomy === 'artiodactyla') return 'mammal';
            if (taxonomy === '有鳞目' || taxonomy === '龟鳖目') return 'reptile';
            if (taxonomy === 'fish') return 'fish';
            if (taxonomy === 'invertebrate') return 'invertebrate';
            return '';
        }

        function renderGallery() {
            var gallery = document.getElementById('gallery');
            gallery.innerHTML = '';
            updateHeroStats();

            if (animals.length === 0) {
                var state = document.createElement('div');
                state.className = 'gallery-state';
                state.textContent = hasLoadedRemoteSpecies ? 'No species records yet.' : 'Loading species records...';
                gallery.appendChild(state);
                applyFilters();
                return;
            }

            animals.forEach(function(item, index) {
                var card = document.createElement('div');
                card.className = 'card animal-card';
                card.setAttribute('data-iucn', item.iucn || '');
                card.setAttribute('data-group-type', item.groupType || '');
                card.setAttribute('data-taxonomy', item.taxonomy || '');
                card.setAttribute('data-name', item.name || '');
                card.setAttribute('data-latin-name', item.latinName || '');

                var imageWrapper = document.createElement('div');
                imageWrapper.className = 'card-img-wrapper';
                imageWrapper.onclick = function() { openModal(index); };

                if (item.images && item.images.length > 0) {
                    var img = document.createElement('img');
                    img.alt = item.name;
                    img.loading = 'lazy';
                    img.decoding = 'async';
                    img.addEventListener('load', function() {
                        this.classList.add('is-loaded');
                    });
                    img.src = (item.thumbnails && item.thumbnails[0]) || item.images[0];
                    if (img.complete) {
                        img.classList.add('is-loaded');
                    }
                    imageWrapper.appendChild(img);

                    if (item.images.length > 1) {
                        var badge = document.createElement('span');
                        badge.className = 'img-count-badge';
                        badge.textContent = item.images.length + ' photos';
                        imageWrapper.appendChild(badge);
                    }
                } else {
                    var placeholder = document.createElement('div');
                    placeholder.className = 'card-placeholder';
                    placeholder.textContent = 'No image';
                    imageWrapper.appendChild(placeholder);
                }

                var body = document.createElement('div');
                body.className = 'card-body';

                var recordId = document.createElement('div');
                recordId.className = 'record-id';
                recordId.textContent = 'FWA-' + String(index + 1).padStart(3, '0');

                var tags = document.createElement('div');
                tags.className = 'card-tags';

                var iucnTag = document.createElement('span');
                iucnTag.className = 'tag tag-iucn-' + (item.iucn || 'LC');
                iucnTag.textContent = iucnLabel(item.iucn);
                tags.appendChild(iucnTag);

                var taxonomyTag = document.createElement('span');
                taxonomyTag.className = 'tag tag-taxonomy';
                taxonomyTag.textContent = taxonomyLabel(item.taxonomy);
                tags.appendChild(taxonomyTag);

                var title = document.createElement('h3');
                title.className = 'card-title';
                title.textContent = item.name;

                var latin = document.createElement('div');
                latin.className = 'card-latin';
                latin.textContent = item.latinName;

                var location = document.createElement('div');
                location.className = 'card-location';
                location.textContent = item.location ? 'Location: ' + item.location : 'Location: unknown';

                var shotDate = document.createElement('div');
                shotDate.className = 'card-location';
                shotDate.textContent = item.shotDate ? 'Shot date: ' + item.shotDate : '';

                var desc = document.createElement('p');
                desc.className = 'card-desc';
                desc.textContent = item.desc || 'No notes';

                var metaGrid = document.createElement('div');
                metaGrid.className = 'record-meta-grid';
                metaGrid.appendChild(createRecordMetaRow('LOCATION', item.location || 'Unknown'));
                metaGrid.appendChild(createRecordMetaRow('OBSERVED', item.shotDate || 'Not recorded'));
                metaGrid.appendChild(createRecordMetaRow('ORDER', taxonomyLabel(item.taxonomy)));
                metaGrid.appendChild(createRecordMetaRow('STATUS', item.iucn || 'LC', true));

                body.appendChild(recordId);
                body.appendChild(tags);
                body.appendChild(title);
                body.appendChild(latin);
                body.appendChild(location);
                if (item.shotDate) {
                    body.appendChild(shotDate);
                }
                body.appendChild(metaGrid);
                body.appendChild(desc);

                if (item.exif) {
                    var exif = document.createElement('div');
                    exif.className = 'exif-tag';
                    exif.textContent = '馃摲 ' + item.exif;
                    body.appendChild(exif);
                }

                card.appendChild(imageWrapper);
                card.appendChild(body);
                gallery.appendChild(card);
            });

            applyFilters();
        }

        function createRecordMetaRow(label, value, isStatus) {
            var row = document.createElement('div');
            row.className = 'record-meta-row';

            var labelElement = document.createElement('span');
            labelElement.className = 'record-meta-label';
            labelElement.textContent = label;

            var valueElement = document.createElement('span');
            valueElement.className = 'record-meta-value';

            if (isStatus) {
                var status = document.createElement('span');
                status.className = 'status-label';
                status.textContent = value;
                valueElement.appendChild(status);
            } else {
                valueElement.textContent = value;
            }

            row.appendChild(labelElement);
            row.appendChild(valueElement);
            return row;
        }

        window.openModal = function(animalIdx) {
            currentAnimalIndex = animalIdx;
            currentImageIndex = 0;

            var item = animals[animalIdx];
            if (!item) return;

            document.getElementById('m-title').textContent = item.name;
            document.getElementById('m-latin').textContent = item.latinName;
            document.getElementById('m-location').textContent = 'Location: ' + (item.location || 'Unknown') + (item.shotDate ? ' · Shot date: ' + item.shotDate : '');
            document.getElementById('m-desc').textContent = item.desc;
            document.getElementById('m-exif').textContent = item.exif ? 'Camera record: ' + item.exif : '';

            updateGalleryDisplay();
            document.getElementById('image-modal').classList.add('open');
        };

        function updateGalleryDisplay() {
            var item = animals[currentAnimalIndex];
            var images = item.images || [];
            var prevBtn = document.querySelector('.prev-btn');
            var nextBtn = document.querySelector('.next-btn');
            var thumbContainer = document.getElementById('m-thumbnails');

            if (images.length === 0) {
                document.getElementById('m-img').removeAttribute('src');
                prevBtn.style.display = 'none';
                nextBtn.style.display = 'none';
                thumbContainer.style.display = 'none';
                thumbContainer.innerHTML = '';
                return;
            }

            document.getElementById('m-img').src = images[currentImageIndex];

            if (images.length <= 1) {
                prevBtn.style.display = 'none';
                nextBtn.style.display = 'none';
            } else {
                prevBtn.style.display = 'block';
                nextBtn.style.display = 'block';
            }

            thumbContainer.innerHTML = '';
            
            if (images.length > 1) {
                thumbContainer.style.display = 'flex';
                images.forEach(function(src, imgIdx) {
                    var thumb = document.createElement('img');
                    thumb.src = src;
                    thumb.className = 'thumb-img' + (imgIdx === currentImageIndex ? ' active' : '');
                    thumb.onclick = function() {
                        currentImageIndex = imgIdx;
                        updateGalleryDisplay();
                    };
                    thumbContainer.appendChild(thumb);
                });
            } else {
                thumbContainer.style.display = 'none';
            }
        }

        window.prevImage = function(e) {
            if (e) e.stopPropagation();
            var images = animals[currentAnimalIndex].images;
            currentImageIndex = (currentImageIndex - 1 + images.length) % images.length;
            updateGalleryDisplay();
        };

        window.nextImage = function(e) {
            if (e) e.stopPropagation();
            var images = animals[currentAnimalIndex].images;
            currentImageIndex = (currentImageIndex + 1) % images.length;
            updateGalleryDisplay();
        };

        window.closeModal = function(e) {
            if (!e || e.target.id === 'image-modal' || e.target.classList.contains('modal-close')) {
                document.getElementById('image-modal').classList.remove('open');
            }
        };

        document.addEventListener('keydown', function(e) {
            var modal = document.getElementById('image-modal');
            if (modal.classList.contains('open')) {
                if (e.key === 'Escape') closeModal();
                if (e.key === 'ArrowLeft') prevImage();
                if (e.key === 'ArrowRight') nextImage();
            } else if (e.key === 'Escape') {
                closeSidebar();
            }
        });

        window.openSidebar = function() {
            document.getElementById('category-sidebar').classList.add('open');
            document.getElementById('sidebar-backdrop').classList.add('open');
        };

        window.closeSidebar = function() {
            document.getElementById('category-sidebar').classList.remove('open');
            document.getElementById('sidebar-backdrop').classList.remove('open');
        };

        window.setCollectionGroup = function(btn) {
            setGroupFilter(btn.getAttribute('data-group') || 'all');
        };

        function setGroupFilter(value) {
            currentFilter.group = value;
            syncGroupControls(value);
            applyFilters();
        }

        function syncGroupControls(value) {
            document.querySelectorAll('.collection-tab[data-group], .sidebar-item[data-group]').forEach(function(control) {
                control.classList.toggle('active', control.getAttribute('data-group') === value);
            });
        }

        window.setSidebarCategory = function(btn) {
            var value = btn.getAttribute('data-group');
            setGroupFilter(value);
            closeSidebar();
        };

        window.setSidebarSearch = function(value) {
            currentFilter.search = value.trim().toLowerCase();
            applyFilters();
        };

        function applyFilters() {
            var cards = document.querySelectorAll('.animal-card');
            cards.forEach(function(card) {
                var cardIucn = card.getAttribute('data-iucn');
                var cardGroupType = card.getAttribute('data-group-type');
                var cardName = (card.getAttribute('data-name') || '').toLowerCase();
                var cardLatinName = (card.getAttribute('data-latin-name') || '').toLowerCase();
                var groupType = sidebarGroups[currentFilter.group] || 'all';

                var matchIucn = (currentFilter.iucn === 'all' || cardIucn === currentFilter.iucn);
                var matchGroup = (groupType === 'all' || cardGroupType === groupType);
                var matchSearch = (
                    currentFilter.search === '' ||
                    cardName.indexOf(currentFilter.search) !== -1 ||
                    cardLatinName.indexOf(currentFilter.search) !== -1
                );

                card.style.display = (matchIucn && matchGroup && matchSearch) ? 'block' : 'none';
            });
        }

        window.toggleTag = function(btn) {
            var type = btn.getAttribute('data-type');
            var value = btn.getAttribute('data-value');

            var siblingBtns = btn.parentElement.querySelectorAll('.filter-btn');
            siblingBtns.forEach(function(b) { b.classList.remove('active'); });
            btn.classList.add('active');

            currentFilter[type] = value;
            applyFilters();
        };

        function escapeHtml(value) {
            return String(value || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function renderMapMarkers() {
            if (!wildlifeMap) return;

            mapMarkerFeatures = [];

            var groupedAnimals = [];
            animals.forEach(function(item, index) {
                if (item.coords && item.coords.length === 2) {
                    var latitude = Number(item.coords[0]);
                    var longitude = Number(item.coords[1]);
                    if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) {
                        return;
                    }

                    var locationId = item.locationId ? String(item.locationId) : '';
                    var group = locationId
                        ? groupedAnimals.find(function(existingGroup) {
                            return existingGroup.locationId === locationId;
                        })
                        : findNearbyMarkerGroup(groupedAnimals, [latitude, longitude]);

                    if (!group) {
                        group = {
                            locationId: locationId,
                            coords: [latitude, longitude],
                            locationName: item.location,
                            list: []
                        };
                        groupedAnimals.push(group);
                    }

                    group.list.push({ item: item, index: index });
                }
            });

            mapMarkerFeatures = groupedAnimals.map(function(group) {
                var latitude = Number(group.coords[0]);
                var longitude = Number(group.coords[1]);

                if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) {
                    return null;
                }

                return {
                    type: 'Feature',
                    geometry: {
                        type: 'Point',
                        coordinates: [longitude, latitude]
                    },
                    properties: {
                        count: String(group.list.length),
                        popupHtml: buildMapPopupHtml(group)
                    }
                };
            }).filter(Boolean);

            renderOverlayMarkers();
            renderMarkerStatus();

            fitMapToMarkers();
        }

        function ensureMarkerOverlay() {
            var mapElement = document.getElementById('map');
            if (!mapElement) return null;

            if (!mapMarkerOverlay) {
                mapMarkerOverlay = document.createElement('div');
                mapMarkerOverlay.className = 'wildlife-marker-overlay';
                mapElement.appendChild(mapMarkerOverlay);
            }

            return mapMarkerOverlay;
        }

        function renderOverlayMarkers() {
            var overlay = ensureMarkerOverlay();
            if (!overlay || !wildlifeMap) return;

            overlay.innerHTML = '';

            mapMarkerFeatures.forEach(function(feature) {
                var button = document.createElement('button');
                button.type = 'button';
                button.className = 'wildlife-map-pin';
                button.setAttribute('aria-label', 'Open observation site');
                button.innerHTML = [
                    '<svg viewBox="0 0 30 42" aria-hidden="true" focusable="false">',
                    '<path d="M15 41C15 41 28 25.9 28 15.2C28 7.4 22.2 2 15 2C7.8 2 2 7.4 2 15.2C2 25.9 15 41 15 41Z" fill="#31543A" stroke="#FAF9F3" stroke-width="3"/>',
                    '<circle cx="15" cy="15" r="6" fill="#FAF9F3" opacity="0.95"/>',
                    '</svg>'
                ].join('');
                button.dataset.lng = String(feature.geometry.coordinates[0]);
                button.dataset.lat = String(feature.geometry.coordinates[1]);
                button.dataset.popupHtml = feature.properties.popupHtml || '';
                button.addEventListener('click', function(event) {
                    event.preventDefault();
                    event.stopPropagation();
                    new maplibregl.Popup({ closeButton: true, closeOnClick: true })
                        .setLngLat([Number(button.dataset.lng), Number(button.dataset.lat)])
                        .setHTML(button.dataset.popupHtml || '')
                        .addTo(wildlifeMap);
                });
                overlay.appendChild(button);
            });

            updateOverlayMarkerPositions();
        }

        function renderMarkerStatus() {
            var mapElement = document.getElementById('map');
            if (!mapElement) return;

            if (!mapMarkerStatus) {
                mapMarkerStatus = document.createElement('div');
                mapMarkerStatus.className = 'map-marker-status';
                mapElement.appendChild(mapMarkerStatus);
            }

            mapMarkerStatus.textContent = 'Observation Sites ' + mapMarkerFeatures.length;
        }

        function updateOverlayMarkerPositions() {
            if (!wildlifeMap || !mapMarkerOverlay) return;

            var pins = mapMarkerOverlay.querySelectorAll('.wildlife-map-pin');
            pins.forEach(function(pin) {
                var point = wildlifeMap.project([Number(pin.dataset.lng), Number(pin.dataset.lat)]);
                pin.style.left = point.x + 'px';
                pin.style.top = point.y + 'px';
            });
        }

        function fitMapToMarkers() {
            if (!wildlifeMap || mapMarkerFeatures.length === 0 || typeof maplibregl === 'undefined') return;

            var bounds = new maplibregl.LngLatBounds();
            mapMarkerFeatures.forEach(function(feature) {
                bounds.extend(feature.geometry.coordinates);
            });

            if (mapMarkerFeatures.length === 1) {
                wildlifeMap.easeTo({
                    center: mapMarkerFeatures[0].geometry.coordinates,
                    zoom: Math.max(wildlifeMap.getZoom(), 10),
                    duration: 400
                });
                return;
            }

            wildlifeMap.fitBounds(bounds, {
                padding: 60,
                maxZoom: 10,
                duration: 500
            });
        }

        function buildMapPopupHtml(group) {
            var popupHtml = '<div style="max-height:180px; overflow-y:auto; padding-right:5px;">';
            popupHtml += '<strong style="color:#31543A;">Observation Site / ' + escapeHtml(group.locationName) + ' (' + group.list.length + ' records)</strong>';
            popupHtml += '<hr style="margin:6px 0; border:0; border-top:1px solid #eee;"/>';

            group.list.forEach(function(obj) {
                popupHtml += '<div style="margin-bottom:8px; display:flex; justify-content:space-between; align-items:center; gap:10px;">';
                popupHtml += '<span style="font-weight:bold;">' + escapeHtml(obj.item.name) + '</span>';
                popupHtml += '<a href="javascript:void(0)" onclick="openModal(' + obj.index + ')" style="color:#31543A; text-decoration:underline; font-size:12px;">查看记录</a>';
                popupHtml += '</div>';
            });
            popupHtml += '</div>';
            return popupHtml;
        }

        function findNearbyMarkerGroup(groups, coords) {
            for (var index = 0; index < groups.length; index += 1) {
                var group = groups[index];
                if (distanceBetweenCoords(group.coords, coords) <= MARKER_CLUSTER_RADIUS_METERS) {
                    return group;
                }
            }
            return null;
        }

        function distanceBetweenCoords(first, second) {
            var earthRadiusMeters = 6371000;
            var lat1 = toRadians(Number(first[0]));
            var lat2 = toRadians(Number(second[0]));
            var deltaLat = toRadians(Number(second[0]) - Number(first[0]));
            var deltaLng = toRadians(Number(second[1]) - Number(first[1]));
            var a = Math.sin(deltaLat / 2) * Math.sin(deltaLat / 2) +
                Math.cos(lat1) * Math.cos(lat2) *
                Math.sin(deltaLng / 2) * Math.sin(deltaLng / 2);
            var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            return earthRadiusMeters * c;
        }

        function toRadians(value) {
            return value * Math.PI / 180;
        }

        var mapStyleMode = 'outdoor';

        function mapStyleUrl(mode) {
            var styleId = mode === 'satellite' ? 'hybrid' : 'outdoor-v2';
            return 'https://api.maptiler.com/maps/' + styleId + '/style.json?key=' + MAPTILER_API_KEY;
        }

        function hideBoundaryAndCountryLayers() {
            var style = wildlifeMap && wildlifeMap.getStyle();
            if (!style || !Array.isArray(style.layers)) return;

            style.layers.forEach(function(layer) {
                var id = String(layer.id || '').toLowerCase();
                var sourceLayer = String(layer['source-layer'] || '').toLowerCase();
                var textField = layer.layout && layer.layout['text-field'] ? JSON.stringify(layer.layout['text-field']).toLowerCase() : '';
                var shouldHide = (
                    id.indexOf('boundary') !== -1 ||
                    id.indexOf('border') !== -1 ||
                    id.indexOf('disputed') !== -1 ||
                    sourceLayer.indexOf('boundary') !== -1 ||
                    (layer.type === 'symbol' && (
                        id.indexOf('country') !== -1 ||
                        textField.indexOf('name:latin') !== -1 && id.indexOf('state') === -1
                    ))
                );

                if (shouldHide && wildlifeMap.getLayer(layer.id)) {
                    wildlifeMap.setLayoutProperty(layer.id, 'visibility', 'none');
                }
            });
        }

        function preferChineseLabels() {
            var style = wildlifeMap && wildlifeMap.getStyle();
            if (!style || !Array.isArray(style.layers)) return;

            style.layers.forEach(function(layer) {
                if (layer.type !== 'symbol' || !wildlifeMap.getLayer(layer.id)) return;
                var textField = layer.layout && layer.layout['text-field'];
                if (!textField) return;

                try {
                    wildlifeMap.setLayoutProperty(layer.id, 'text-field', ['coalesce', ['get', 'name:zh'], ['get', 'name:en'], ['get', 'name']]);
                } catch (error) {
                    console.warn('Could not update label language for layer', layer.id, error);
                }
            });
        }

        function applyMapStyleCleanup() {
            hideBoundaryAndCountryLayers();
            preferChineseLabels();
        }

        function addMapStyleToggle() {
            function StyleToggleControl() {}
            StyleToggleControl.prototype.onAdd = function(map) {
                var container = document.createElement('div');
                container.className = 'maplibregl-ctrl maplibregl-ctrl-group';

                var button = document.createElement('button');
                button.type = 'button';
                button.title = 'Toggle outdoor/satellite map';
                button.textContent = 'SAT';
                button.addEventListener('click', function() {
                    mapStyleMode = mapStyleMode === 'outdoor' ? 'satellite' : 'outdoor';
                    button.textContent = mapStyleMode === 'outdoor' ? 'SAT' : 'MAP';
                    map.setStyle(mapStyleUrl(mapStyleMode));
                });

                container.appendChild(button);
                return container;
            };
            StyleToggleControl.prototype.onRemove = function() {};
            wildlifeMap.addControl(new StyleToggleControl(), 'top-right');
        }

        function initMap() {
            var mapElement = document.getElementById('map');
            if (typeof maplibregl === 'undefined') {
                mapElement.innerHTML = '<div class="map-fallback">Map failed to load.</div>';
                return;
            }

            if (!MAPTILER_API_KEY || MAPTILER_API_KEY === 'YOUR_MAPTILER_API_KEY') {
                mapElement.innerHTML = '<div class="map-fallback">MapTiler API key is required.</div>';
                return;
            }

            wildlifeMap = new maplibregl.Map({
                container: 'map',
                style: mapStyleUrl(mapStyleMode),
                center: [104.06, 30.65],
                zoom: 5
            });

            wildlifeMap.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
            addMapStyleToggle();
            mapPopup = new maplibregl.Popup({ closeButton: true, closeOnClick: true });

            wildlifeMap.on('style.load', function() {
                applyMapStyleCleanup();
                renderMapMarkers();
            });

            wildlifeMap.on('idle', function() {
                updateOverlayMarkerPositions();
            });
            wildlifeMap.on('move', updateOverlayMarkerPositions);
            wildlifeMap.on('resize', updateOverlayMarkerPositions);
        }

        async function loadRemoteSpecies() {
            try {
                var response = await fetch(API_BASE_URL + '/species');
                if (!response.ok) {
                    hasLoadedRemoteSpecies = true;
                    renderGallery();
                    return;
                }

                var data = await response.json();
                if (!Array.isArray(data.species)) {
                    hasLoadedRemoteSpecies = true;
                    renderGallery();
                    return;
                }

                animals = data.species.map(normalizeApiAnimal);
                hasLoadedRemoteSpecies = true;
                renderGallery();
                renderMapMarkers();
            } catch (error) {
                hasLoadedRemoteSpecies = true;
                renderGallery();
                console.warn('Could not load remote species data', error);
            }
        };

        document.addEventListener("DOMContentLoaded", function() {
            initMap();
        });

        document.addEventListener("DOMContentLoaded", function() {
            loadRemoteSpecies();
        });
    </script>
</body>
</html>
